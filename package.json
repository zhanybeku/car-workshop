{
  "name": "car-workshop",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@sap/cds": "^10"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3"
  },
  "scripts": {
    "start": "cds-serve"
  },
  "private": true,
  "cds": {
    "features": {
      "assert_integrity": "db"
    },
    "fiori": {
      "bypass_draft": true
    },
    "requires": {
      "[development]": {
        "auth": {
          "kind": "mocked",
          "users": {
            "manager": { "password": "manager", "roles": ["Manager"] },
            "mechanic": { "password": "mechanic", "roles": ["Mechanic"] },
            "accountant": { "password": "accountant", "roles": ["Accountant"] },
            "admin": { "password": "admin", "roles": ["Admin"] },
            "alice": false, "bob": false, "carol": false, "dave": false,
            "erin": false, "fred": false, "me": false, "yves": false,
            "*": false
          }
        }
      }
    },
    "workshop": {
      "timezone": "Asia/Almaty"
    }
  }
}
