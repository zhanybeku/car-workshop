{
  "_version": "1.65.0",
  "sap.app": {
    "id": "workshop.orders",
    "type": "application",
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "applicationVersion": { "version": "1.0.0" },
    "i18n": "i18n/i18n.properties",
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/workshop/",
        "type": "OData",
        "settings": { "odataVersion": "4.0" }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": { "desktop": true, "tablet": true, "phone": true }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.148.0",
      "libs": { "sap.m": {}, "sap.ui.core": {}, "sap.fe.templates": {} }
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": { "bundleName": "workshop.orders.i18n.i18n" }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "routing": {
      "routes": [
        {
          "pattern": ":?query:",
          "name": "ServiceOrdersList",
          "target": "ServiceOrdersList"
        },
        {
          "pattern": "ServiceOrders({key}):?query:",
          "name": "ServiceOrdersObjectPage",
          "target": "ServiceOrdersObjectPage"
        }
      ],
      "targets": {
        "ServiceOrdersList": {
          "type": "Component",
          "id": "ServiceOrdersList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/ServiceOrders",
              "variantManagement": "Page",
              "initialLoad": "Enabled",
              "navigation": {
                "ServiceOrders": {
                  "detail": { "route": "ServiceOrdersObjectPage" }
                }
              }
            }
          }
        },
        "ServiceOrdersObjectPage": {
          "type": "Component",
          "id": "ServiceOrdersObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "contextPath": "/ServiceOrders",
              "editableHeaderContent": false,
              "enhanceI18n": "i18n/i18n.properties",
              "controlConfiguration": {
                "items/@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "creationMode": { "name": "Inline" }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  }
}
